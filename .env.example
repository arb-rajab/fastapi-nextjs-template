# Copy to .env and adjust for local development. Never commit .env.

# PostgreSQL admin/owner role (runs migrations)
POSTGRES_USER=starterapp
POSTGRES_PASSWORD=starterapp
POSTGRES_DB=starterapp
DATABASE_ADMIN_URL=postgresql+psycopg://starterapp:starterapp@postgres:5432/starterapp

# PostgreSQL restricted runtime role (created by migration 0002)
APP_DB_ROLE=starterapp_app
APP_DB_PASSWORD=starterapp_app_dev_only
DATABASE_URL=postgresql+psycopg://starterapp_app:starterapp_app_dev_only@postgres:5432/starterapp

# Redis (rate limiting)
REDIS_URL=redis://redis:6379/0

# Signs and verifies session tokens. The value below is a labelled dev-only
# placeholder: every real deployment MUST override it with a long random
# secret, because anyone who has read this repository can forge tokens signed
# with the default.
JWT_SECRET_KEY=starterapp-dev-only-jwt-secret-DO-NOT-USE-IN-PRODUCTION
# Login attempts per username per 5 minutes before a 429.
LOGIN_RATE_LIMIT_PER_5_MINUTES=10
# Registration attempts across the whole instance per 5 minutes before a 429.
REGISTER_RATE_LIMIT_PER_5_MINUTES=20

# Frontend: server-side URL the Next.js route handlers use to reach the backend.
BACKEND_URL=http://backend:8000
# Set to true only once the app is served over HTTPS.
COOKIE_SECURE=false

# Production stack only (docker-compose.prod.yml); shown with defaults.
# LOG_LEVEL=info
# WEB_CONCURRENCY=4
# GUNICORN_TIMEOUT=60
