# Production backend image: gunicorn managing uvicorn workers, a builder
# stage so the runtime image carries no build toolchain, and a non-root user.
# Build context is `backend/`:  docker build -f docker/Dockerfile.prod .

FROM python:3.12-slim AS builder

WORKDIR /build

COPY pyproject.toml ./
COPY src ./src

RUN pip install --no-cache-dir --prefix=/install '.[prod]'

FROM python:3.12-slim

RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin starterapp

WORKDIR /app

COPY --from=builder /install /usr/local
COPY src ./src
COPY alembic ./alembic
COPY alembic.ini ./
COPY docker/entrypoint.prod.sh ./docker/entrypoint.prod.sh

RUN chown -R starterapp:starterapp /app
USER starterapp

EXPOSE 8000

ENV PYTHONUNBUFFERED=1 \
    WEB_CONCURRENCY=4 \
    GUNICORN_TIMEOUT=60 \
    LOG_LEVEL=info

CMD ["sh", "docker/entrypoint.prod.sh"]
